<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rafika - Sistem Reservasi & Pelaporan Fasilitas Kampus</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inconsolata:wght@200..900&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/_navbar') %>
    
    <div class="d-flex flex-column flex-grow-1 align-items-center justify-content-center bg-light px-4">
        <div class="d-flex flex-column align-items-center justify-content-center bg-white shadow-sm rounded-3 my-4 px-4 py-3 w-100" style="max-width: 576px;">
            <h2 class="fw-bold">
                Daftar
            </h2>

            <form class="d-flex flex-column align-items-center justify-content-center my-2 w-100" action="/daftar" method="POST">
                <%- include('partials/_textField', {
                    name: 'email',
                    label: 'Email',
                    type: 'text',
                    value: locals.oldInput?.email || '', 
                    errorMessage: locals.errors?.email
                }) %>

                <%- include('partials/_textField', {
                    name: 'name',
                    label: 'Nama Lengkap',
                    type: 'text',
                    value: locals.oldInput?.name || '', 
                    errorMessage: locals.errors?.name
                }) %>

                <%- include('partials/_textField', {
                    name: 'password',
                    label: 'Password',
                    type: 'password',
                    errorMessage: locals.errors?.password
                }) %>

                <%- include('partials/_textField', {
                    name: 'confirmation',
                    label: 'Konfirmasi Password',
                    type: 'password',
                    errorMessage: locals.errors?.confirmation
                }) %>

                <div class="mt-2 w-100">
                    <%- include('partials/_buttonSolid', {
                        type: 'submit',
                        buttonClass: 'w-100',
                        label: 'Daftar'
                    }) %>
                </div>
            </form>

            <p class="text-center text-muted fw-light" style="color: var(--black);">
                Sudah memiliki akun? <a href="/masuk" class="text-decoration-none">Masuk di sini</a>
            </p>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
