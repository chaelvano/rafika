<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rafika - Sistem Reservasi & Pelaporan Fasilitas Kampus</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inconsolata:wght@200..900&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container d-flex flex-column justify-content-center align-items-center min-vh-100">
    <h1 class="display-1 fw-bold"><%= status %></h1>

    <p class="text-muted fs-5 fw-light mb-4"><%= errors.message || 'Terjadi kesalahan' %></p>
    
    <a href="/">
      <%- include('partials/_buttonSolid', {
        iconClass: 'bi-chevron-left',
        label: 'Kembali'
      }) %>
    </a>

    <% if (errors && errors.stack) { %>
      <div class="container d-flex flex-column justify-content-center align-items-center mt-4 gap-2">
          <a data-bs-toggle="collapse" href="#error-stack" role="button">
            <%- include('partials/_buttonRed', {
              iconClass: 'bi-chevron-down',
              label: '<span class="fw-semibold">[DEV]</span> Error Stack'
            }) %>
          </a>

          <div id="error-stack" class="collapse">
            <pre class="text-danger fw-light" style="white-space: pre-wrap;"><%= errors.stack %></pre>
          </div>
      </div>

      <!-- Toggle chevron icon on collapse -->
      <script>
        const errorStack = document.getElementById('error-stack');
        const icon = document.querySelector('[href="#error-stack"] i');

        errorStack.addEventListener('show.bs.collapse', () => {
          icon.classList.replace('bi-chevron-down', 'bi-chevron-up');
        });
        
        errorStack.addEventListener('hide.bs.collapse', () => {
          icon.classList.replace('bi-chevron-up', 'bi-chevron-down');
        });
      </script>
    <% } %>
  </div>
  
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
